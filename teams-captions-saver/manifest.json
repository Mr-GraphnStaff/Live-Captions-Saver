{
  "manifest_version": 3,
  "name": "Better CaptionKeep",
  "version": "4.6",
  "description": "Save live captions from Microsoft Teams in Microsoft Edge, with TXT and Markdown exports and flexible save locations.",
  "homepage_url": "https://github.com/Mr-GraphnStaff/better-captionkeep",
  "icons": {
    "16": "icons/scribble-16.png",
    "32": "icons/scribble-32.png",
    "48": "icons/scribble-48.png",
    "128": "icons/scribble-128.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/scribble-16.png",
      "32": "icons/scribble-32.png",
      "48": "icons/scribble-48.png",
      "128": "icons/scribble-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Better CaptionKeep — by Señor Farris"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.js",
        "sessionManager.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "author": "Señor Farris"
}
